-- Hook UpdateShop
UpdateShopRemote.OnClientEvent:Connect(function(data)
    if type(data) ~= "table" then return end
    LatestShopData = data

    -- 更新基础信息
    pcall(function()
        creditsLabel:SetDesc(tostring(data.Credits or "未知"))
        winsLabel:SetDesc(tostring(data.Wins or "未知"))
        equippedLabel:SetDesc(tostring(data.EquippedSurvivor or "未知"))
        versionLabel:SetDesc(tostring(data.Version or "未知"))
    end)

    -- 更新个人资料
    pcall(function()
        local profile = data.Profile or {}
        local identity = profile.Identity or {}
        local career = profile.CareerStats or {}
        titleLabel:SetDesc(tostring(identity.Title or "未知"))
        streakLabel:SetDesc(tostring(identity.TitleStreak or "未知"))
        dmgLabel:SetDesc(tostring(career.DamageTaken or "未知"))
        revivesLabel:SetDesc(tostring(career.Revives or "未知"))
    end)

    -- 更新角色解锁状态
    pcall(function()
        local survivors = data.Survivors or {}
        local unlocked = {}
        local locked = {}
        for name, info in pairs(survivors) do
            if info.Unlocked then
                local exp = info.EXP or 0
                table.insert(unlocked, string.format("%s (EXP: %d)", name, exp))
            else
                table.insert(locked, name)
            end
        end
        local desc = "已解锁(" .. #unlocked .. "): " .. table.concat(unlocked, ", ")
        if #locked > 0 then
            desc = desc .. "\n未解锁(" .. #locked .. "): " .. table.concat(locked, ", ")
        end
        survivorStatusLabel:SetDesc(desc)
    end)
end)

